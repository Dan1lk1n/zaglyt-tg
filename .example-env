BOT_TOKEN=""
BOT_NAME=""

DEVELOPERS="developer_id_1 developer_id_2 developer_id_3"

# ---- Update mode ----
# polling (default) | webhook
BOT_MODE="polling"

# Required when BOT_MODE=webhook.
# Public HTTPS BASE URL (scheme + host only, no path), e.g. https://example.com
# The full webhook URL is assembled automatically as WEBHOOK_URL + WEBHOOK_PATH.
WEBHOOK_URL=""
# Secret sent by Telegram in the X-Telegram-Bot-Api-Secret-Token header and
# verified on every request. Use a long random string. Required for webhook.
WEBHOOK_SECRET="openssl rand -hex 32"
# Local address the HTTP server listens on (inside the container).
WEBHOOK_LISTEN_ADDR=":8080"
# Path the webhook is served on, appended to WEBHOOK_URL to form the full URL.
# Use a hard-to-guess segment for extra cover, e.g. /webhook/<random>.
WEBHOOK_PATH="/webhook"
# Restrict incoming requests to Telegram's published IP ranges. Disable this if
# you sit behind a reverse proxy/CDN (RemoteAddr would be the proxy, not Telegram).
WEBHOOK_IP_ALLOWLIST_ENABLED="true"

# ---- Logging ----
LOG_LEVEL="info"
LOG_FORMAT="text"

# ---- Morphology (mystem) ----
# Max number of cached morphological-analysis results (bounds RAM by entry
# count). 0 disables the cache. Default: 20000.
MYSTEM_CACHE_SIZE="20000"

# Option 1 (recommended): a single connection string.
# When DATABASE_URL is set, the DB_* variables below are ignored.
DATABASE_URL="postgres://user:password@host:5432/dbname?sslmode=disable"

# Option 2: individual parts (used only when DATABASE_URL is empty).
DB_DRIVER=""
DB_HOST=""
DB_PORT=""
DB_USER=""
DB_PASSWORD="!"
DB_NAME=""

# ---- Local LLM (optional) ----
# Enable the llm container (llama.cpp + Vikhr-Gemma-2B Q4) in compose.
# Remove this line (or `docker compose stop llm`) to free RAM: the bot then
# answers with the plain Markov pipeline.
COMPOSE_PROFILES="llm"
# Server URL; set to "" to disable the LLM in the bot entirely.
LLM_URL="http://llm:8080"
# Persona override; empty uses the built-in rude chat persona.
LLM_SYSTEM_PROMPT=""
LLM_TIMEOUT_SECONDS="30"
# Reply length cap in tokens (~80 tokens ≈ 250 chars of Russian).
LLM_MAX_TOKENS="80"
# Prompt budget: oldest chat messages are dropped to stay under it.
LLM_MAX_PROMPT_CHARS="2500"
LLM_CONTEXT_MESSAGES="15"
# llm container limits.
LLM_MEM_LIMIT="2560m"
# Model to serve (any GGUF on HuggingFace that fits LLM_MEM_LIMIT).
LLM_HF_REPO="Vikhrmodels/Vikhr-Gemma-2B-instruct-GGUF"
LLM_HF_FILE="Vikhr-Gemma-2B-instruct-Q4_K_S.gguf"
LLM_CTX_SIZE="4096"
LLM_THREADS="2"
# JSON with chat member profiles (see personas.example.json). Holds real names
# and Telegram IDs, so it is gitignored; mount it into the bot container.
LLM_PERSONAS_FILE=""
# Simultaneous LLM requests (match llama-server --parallel). When all are busy
# the bot replies with Markov immediately instead of queueing.
LLM_CONCURRENCY="1"

# ---- Concurrency ----
# Updates processed in parallel, so a slow LLM reply doesn't stall the chat.
BOT_WORKERS="8"
